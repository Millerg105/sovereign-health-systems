# Sovereign Health Systems - Environment Variables Template
# Copy this to .env (for local dev) and add these to your Vercel Project Settings.

# Required for Lead Notifications
RESEND_API_KEY=re_your_key_here

# Required if moving leads to Zapier/Google Sheets
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_id

# Required for direct browser uploads on /client-inquiry
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Required for server-side booking inserts (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=sbp_your_service_role_key_here

# Optional: ID of your tracking spreadsheet (for internal reference)
LEADS_SPREADSHEET_ID=1VolBtmEzAE3RfxRciJY6A_SmvutyPzE01op2o-o6m5g

# Google Calendar Service Account (for booking → calendar events)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Twilio missed-call text-back
TWILIO_ACCOUNT_SID=AC_your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+44xxxxxxxxxx
TWILIO_WEBHOOK_URL=https://sovereignsystem.co.uk/api/twilio/missed-call
